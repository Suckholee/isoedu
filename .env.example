# Supabase Configuration
# cloud: Supabase only; local: explicit browser-only demo
NEXT_PUBLIC_DATA_MODE=cloud
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: venture document generation. Never use NEXT_PUBLIC_ for this key.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-5.5

# Optional: local LibreOffice executable for Word / Excel / PowerPoint previews
# ISOEDU_SOFFICE=/absolute/path/to/soffice

# Server-only KIPRIS Plus patent/utility publication API key
KIPRIS_API_KEY=
