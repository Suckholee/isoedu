# Supabase Configuration
# cloud: Supabase only; local: explicit browser-only demo
NEXT_PUBLIC_DATA_MODE=cloud
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: LLM API Key (if connecting live Gemini/OpenAI API)
# GEMINI_API_KEY=

# Optional: local LibreOffice executable for Word / Excel / PowerPoint previews
# ISOEDU_SOFFICE=/absolute/path/to/soffice
